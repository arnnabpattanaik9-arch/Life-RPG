# Life RPG Backend Environment Variables Template
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# PostgreSQL Connection String (Local Development or Remote Production)
# Local PostgreSQL 17:
# DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/life_rpg?schema=public"
# Remote Neon PostgreSQL (Production with SSL and connection pooling):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Alternative: individual connection parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_POSTGRES_PASSWORD
PGDATABASE=life_rpg
