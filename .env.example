# Life RPG Web Application - Environment Variables Template

# Set to 'false' to connect to your real Node/Express/FastAPI/PostgreSQL backend API
VITE_USE_MOCK_API=true

# URL of your backend REST API (used when VITE_USE_MOCK_API is set to false)
VITE_API_URL=http://localhost:5000/api

# App environment mode
VITE_APP_ENV=development
